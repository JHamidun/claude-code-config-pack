# === Обязательные для большинства каналов ===

SERPAPI_API_KEY=<ваш ключ с serpapi.com>
# Используется: СМИ (Google/Яндекс), VK, Дзен, LiveLib, маркетплейсы.
# Получить: https://serpapi.com → Sign Up → API Key

# === Опциональные (расширяют покрытие) ===

SCRAPECREATORS_API_KEY=<ключ с scrapecreators.com>
# Используется: YouTube, Instagram, TikTok, Reddit
# Получить: https://scrapecreators.com → Dashboard → API Key

GOOGLE_API_KEY=<ключ Google Cloud>
# Используется: YouTube Data API v3 (прямой поиск, дешевле кредитов)
# Получить: https://console.cloud.google.com → Credentials → Create API Key
# Важно: включить «YouTube Data API v3» в разделе Library для этого проекта

CLOUDFLARE_GLOBAL_API_KEY=<Global API Key из Cloudflare>
# Используется: Cloudflare Radar (уточнение охвата СМИ)
# Получить: https://dash.cloudflare.com → My Profile → API Tokens → Global API Key

CLOUDFLARE_EMAIL=<email аккаунта Cloudflare>
# Пара к CLOUDFLARE_GLOBAL_API_KEY

BRAVE_API_KEY=<ключ с search.brave.com/app>
# Используется: резервный веб-поиск (опц.)
# Получить: https://search.brave.com/app

# === Telegram (один из двух вариантов) ===

# Вариант А — встроенный клиент (lib/tg_telethon.py):
TELEGRAM_API_ID=<числовой ID с my.telegram.org>
TELEGRAM_API_HASH=<хэш с my.telegram.org>
TELEGRAM_PHONE=<+1234567890>
# Получить: https://my.telegram.org → App → создать приложение

# Вариант Б — ваш внешний Telethon-клиент:
TG_CLIENT_PATH=
# Путь к скрипту, поддерживающему команды search-global / search

# === RSSHub (TG-каналы) ===

RSSHUB_BASE_URL=https://rsshub.app
# По умолчанию — публичный инстанс. Замените на адрес своего сервера, если есть.

RSSHUB_SSH_HOST=
# Опц.: hostname (из ~/.ssh/config) если ваш RSSHub доступен только по SSH

RSSHUB_TG_CHANNELS=
# Опц.: дополнительные TG-каналы через запятую (slug без @), например: knigiklass,chitaem

# === Опциональные расширения ===

YANDEX_WORDSTAT_COOKIE=
# Кука залогиненного браузера для wordstat.yandex.ru (обновлять ~раз в 2 недели)
# Получить: открыть wordstat.yandex.ru в браузере, DevTools → Application → Cookies

VK_TOKEN=
# Пользовательский токен VK — нужен только для получения лайков/просмотров.
# Без токена VK-посты находятся через SerpAPI (site:vk.com), лайки = 0.

RSS_FEEDS=
# Дополнительные RSS-фиды через запятую, например:
# https://godliteratury.ru/rss.xml,https://knigoboz.ru/feed/rss/

# === НЕ задавать (иначе LLM уйдёт в платный API вместо подписки) ===
# ANTHROPIC_API_KEY=
