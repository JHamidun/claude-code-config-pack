# =====================================================================
# CLAUDE CODE — MASTER CREDENTIALS TEMPLATE
# =====================================================================
# Copy to ~/.claude/.credentials.master.env, fill in keys you actually use.
#
# HOW TO FILL: uncomment the line (drop the leading '# ') and paste the value
# after '='. The comment at the end of each line names what belongs there.
#     # OPENAI_API_KEY=          # your_openai_api_key
#  ->  OPENAI_API_KEY=sk-...
#
# Lines stay COMMENTED OUT on purpose. A placeholder value like
# `OPENAI_API_KEY=your_openai_api_key` is a non-empty string, so every
# `if not key:` guard in the pack treats it as configured — tools then send the
# placeholder and come back with a bare 401 instead of "key is not set".
#
# NEVER commit this file to git.
# =====================================================================

# AI MODELS
# ANTHROPIC_API_KEY=          # your_anthropic_api_key
# OPENAI_API_KEY=          # your_openai_api_key
# GOOGLE_API_KEY=          # your_google_api_key
# PERPLEXITY_API_KEY=          # your_perplexity_api_key
# DEEPSEEK_API_KEY=          # your_deepseek_api_key
# KIMI_API_KEY=          # your_kimi_api_key

# MEDIA
# ELEVENLABS_API_KEY=          # your_elevenlabs_api_key
# DEEPGRAM_API_KEY=          # your_deepgram_api_key
# DEEPL_API_KEY=          # your_deepl_api_key
# HEYGEN_API_KEY=          # your_heygen_api_key
# DID_API_KEY=          # your_did_api_key
# SUBMAGIC_API_KEY=          # your_submagic_api_key
# GAMMA_API_KEY=          # your_gamma_api_key
# REPLICATE_API_KEY=          # your_replicate_api_key

# DEV TOOLS
# GITHUB_TOKEN=          # your_github_token
# LINEAR_API_KEY=          # your_linear_api_key
# SENTRY_AUTH_TOKEN=          # your_sentry_auth_token
# FIGMA_ACCESS_TOKEN=          # your_figma_access_token
# PINECONE_API_KEY=          # your_pinecone_api_key

# INTEGRATIONS
# NOTION_API_KEY=          # your_notion_api_key
# SLACK_BOT_TOKEN=          # your_slack_bot_token
# SLACK_TEAM_ID=          # your_slack_team_id
# AIRTABLE_API_KEY=          # your_airtable_api_key
# SERPAPI_API_KEY=          # your_serpapi_api_key
# APIFY_API_TOKEN=          # your_apify_api_token
# BRAVE_API_KEY=          # your_brave_api_key

# TELEGRAM
# TELEGRAM_API_ID=          # your_telegram_api_id
# TELEGRAM_API_HASH=          # your_telegram_api_hash
# TELEGRAM_PHONE=          # +1234567890
# BOT_TOKEN=          # your_bot_token

# GOOGLE WORKSPACE
# GOOGLE_OAUTH_CLIENT_ID=          # your_google_oauth_client_id
# GOOGLE_OAUTH_CLIENT_SECRET=          # your_google_oauth_client_secret
# GMAIL_APP_PASSWORD=          # your_gmail_app_password

# CLOUDFLARE / AWS
# CLOUDFLARE_GLOBAL_API_KEY=          # your_cloudflare_api_key
# CLOUDFLARE_EMAIL=          # your_cloudflare_email
# AWS_ACCESS_KEY_ID=          # your_aws_access_key
# AWS_SECRET_ACCESS_KEY=          # your_aws_secret_key

# OPTIONAL SERVERS
# DATABASE_URL_EXTERNAL=          # postgresql://user:password@your-server:5432/your_database
# REDIS_URL_EXTERNAL=          # redis://:your_password@your-server:6379

# N8N
# N8N_MCP_JWT=          # your_n8n_mcp_jwt
# N8N_BASE_URL=          # https://your-name.app.n8n.cloud

# MISC
# JWT_SECRET=          # your_jwt_secret

# =====================================================================
# Pass-66: ключи, которые скрипты пака реально читают через os.getenv,
# но которых в шаблоне не было — без них скилл падал или молча ничего не делал,
# а пользователь даже не знал, что нужен ключ.
# =====================================================================

# DATA / ENRICHMENT
# DADATA_API_KEY=          # your_dadata_api_key
# CRM_PROD_BASE_URL=          # https://your-company.crm.ru
# CRM_PROD_WEBHOOK_PATH=          # /rest/1/your_webhook_code
# CRM_WEBHOOK_URL=          # https://your-company.crm.ru/rest/1/your_webhook_code

# AI / MEDIA
# GEMINI_API_KEY=          # your_gemini_api_key
# GOOGLE_GENAI_API_KEY=          # your_google_genai_api_key
# GOOGLE_CLOUD_PROJECT_ID=          # your_gcp_project_id
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH=          # /path/to/service-account.json
# HUGGINGFACE_API_KEY=          # your_huggingface_api_key
# HIGGSFIELD_ACCESS_TOKEN=          # your_higgsfield_token
# FREESOUND_API_KEY=          # your_freesound_api_key

# AI-TEXT DETECTORS (skill linkedin-humanizer)
# GPTZERO_API_KEY=          # your_gptzero_api_key
# COPYLEAKS_API_KEY=          # your_copyleaks_api_key
# COPYLEAKS_EMAIL=          # your_copyleaks_account_email

# SMART HOME (skill home-assistant)
HA_URL=http://homeassistant.local:8123
# HA_TOKEN=          # your_home_assistant_long_lived_token

# SMS (skill sms-twilio)
# TWILIO_ACCOUNT_SID=          # your_twilio_account_sid
# TWILIO_AUTH_TOKEN=          # your_twilio_auth_token
# TWILIO_FROM_NUMBER=          # +1234567890

# MIRO (skill miro, REST-путь; MCP-путь ключа не требует — там OAuth)
# MIRO_ACCESS_TOKEN=          # your_miro_access_token

# WEBHOOKS (skill webhook-receiver)
# WEBHOOK_GITHUB_SECRET=          # your_github_webhook_secret
# WEBHOOK_STRIPE_SECRET=          # your_stripe_webhook_secret

# LOCAL API SERVER (skill agent-api-server) — токен для доступа к локальному эндпоинту
# AGENT_API_TOKEN=          # choose_any_long_random_string

# LOCAL AI GATEWAY (skill local-gateway)
AI_GATEWAY_URL=http://127.0.0.1:GATEWAY_PORT
# AI_GATEWAY_KEY=          # your_local_gateway_key

# =====================================================================
# Ниже — НЕ секреты, а необязательный тюнинг: у всех есть рабочие значения
# по умолчанию. Раскомментируйте только если нужно поменять поведение.
# =====================================================================
# AGENT_API_HOST=127.0.0.1
# AGENT_API_PORT=8300
# AGENT_API_MODEL=opus
# AGENT_API_TIMEOUT=600
# AGENT_API_MAX_CONCURRENCY=3
# CLAUDE_CLI_PATH=/path/to/claude
# EVAL_JUDGE_TIMEOUT=120
# CC_HOOKS_OFF=1          # аварийно отключить hook-гарды
