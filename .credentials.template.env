# =====================================================================
# CLAUDE CODE — MASTER CREDENTIALS TEMPLATE
# =====================================================================
# Copy to ~/.claude/.credentials.master.env, fill in keys you actually use.
# NEVER commit this file to git.
# =====================================================================

# AI MODELS
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
GOOGLE_API_KEY=your_google_api_key
PERPLEXITY_API_KEY=your_perplexity_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
KIMI_API_KEY=your_kimi_api_key

# MEDIA
ELEVENLABS_API_KEY=your_elevenlabs_api_key
DEEPGRAM_API_KEY=your_deepgram_api_key
DEEPL_API_KEY=your_deepl_api_key
HEYGEN_API_KEY=your_heygen_api_key
DID_API_KEY=your_did_api_key
SUBMAGIC_API_KEY=your_submagic_api_key
GAMMA_API_KEY=your_gamma_api_key
REPLICATE_API_KEY=your_replicate_api_key

# DEV TOOLS
GITHUB_TOKEN=your_github_token
LINEAR_API_KEY=your_linear_api_key
SENTRY_AUTH_TOKEN=your_sentry_auth_token
FIGMA_ACCESS_TOKEN=your_figma_access_token
PINECONE_API_KEY=your_pinecone_api_key

# INTEGRATIONS
NOTION_API_KEY=your_notion_api_key
SLACK_BOT_TOKEN=your_slack_bot_token
SLACK_TEAM_ID=your_slack_team_id
AIRTABLE_API_KEY=your_airtable_api_key
SERPAPI_API_KEY=your_serpapi_api_key
APIFY_API_TOKEN=your_apify_api_token
BRAVE_API_KEY=your_brave_api_key

# TELEGRAM
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_PHONE=+1234567890
BOT_TOKEN=your_bot_token

# GOOGLE WORKSPACE
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
GMAIL_APP_PASSWORD=your_gmail_app_password

# CLOUDFLARE / AWS
CLOUDFLARE_GLOBAL_API_KEY=your_cloudflare_api_key
CLOUDFLARE_EMAIL=your_cloudflare_email
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# OPTIONAL SERVERS
DATABASE_URL_EXTERNAL=postgresql://user:password@your-server:5432/your_database
REDIS_URL_EXTERNAL=redis://:your_password@your-server:6379

# N8N
N8N_MCP_JWT=your_n8n_mcp_jwt
N8N_BASE_URL=https://your-name.app.n8n.cloud

# MISC
JWT_SECRET=your_jwt_secret
