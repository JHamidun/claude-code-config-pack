# ============================================================================
# .credentials.master.env — TEMPLATE
# ============================================================================
# Copy to:  ~/.claude/.credentials.master.env   and fill in ONLY what you use.
# Every key here is referenced by at least one skill/tool in this pack
# (scripts read it via os.getenv or parse this file directly).
# Everything is optional: a missing key disables one skill, not the pack.
#
# NEVER commit the filled-in copy. Keep it out of every repository.
# Format: KEY=value, one per line, no quotes, no spaces around "=".
# An EMPTY value ("KEY=") counts as "not configured" — every guard in the pack
# checks `if not key`. Do not put placeholder text as a value: a non-empty
# placeholder looks configured and turns a clear "key is not set" into a 401.
#
# The pack installer seeds ~/.claude/.credentials.master.env from the pack-root
# .credentials.template.env (a starter subset). This file is the full catalog.
# ============================================================================


# ----------------------------------------------------------------------------
# AI providers — text/LLM
# ----------------------------------------------------------------------------
# Anthropic (skills/claude-api; most of the pack runs on the Claude Code
# subscription instead and needs NO key). https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI (cards-creator image gen, misc gateways). https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional overrides for OpenAI-compatible gateways:
OPENAI_BASE_URL=
OPENAI_IMAGE_MODEL=

# Google Gemini (image-generation, video-generation, many media skills).
# https://aistudio.google.com/apikey
# NOTE: the pack uses GOOGLE_API_KEY as the canonical name; some scripts also
# accept GEMINI_API_KEY / GOOGLE_GENAI_API_KEY — safe to set all three the same.
GOOGLE_API_KEY=
GEMINI_API_KEY=
GOOGLE_GENAI_API_KEY=

# Perplexity API (tools/perplexity_helper.py, /deep-research). https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=
# Perplexity web session cookies as JSON (skills/perplexity/pplx-max.py,
# subscription mode without API billing) — export from your logged-in browser.
PERPLEXITY_COOKIES=

# OpenRouter (multi-model-gateway). https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=

# xAI / Grok (multi-model-gateway). https://console.x.ai/
XAI_API_KEY=
XAI_BASE_URL=

# Hugging Face (model downloads, inference). https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=


# ----------------------------------------------------------------------------
# Search / scraping / OSINT
# ----------------------------------------------------------------------------
# Brave Search (skills/last30days web backend). https://brave.com/search/api/
BRAVE_API_KEY=
# Exa semantic search (skills/last30days). https://exa.ai/
EXA_API_KEY=
# SerpAPI (skills/serpapi — Google SERP). https://serpapi.com/
SERPAPI_API_KEY=
# Apify (skills/apify-scraping). https://console.apify.com/account/integrations
APIFY_API_TOKEN=
# ScrapeCreators (social platform scraping). https://scrapecreators.com/
SCRAPE_CREATORS_API_KEY=
# Shodan (tools/osint_client.py). https://account.shodan.io/
SHODAN_API_KEY=
# OpenSanctions (skills/social-intel KYC checks). https://www.opensanctions.org/api/
OPENSANCTIONS_API_KEY=
# GitHub personal access token (github-gem-seeker, repo lookups). https://github.com/settings/tokens
GITHUB_TOKEN=


# ----------------------------------------------------------------------------
# Speech / audio / video / image services
# ----------------------------------------------------------------------------
# ElevenLabs TTS + voice cloning (skills/elevenlabs). https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Your cloned/preferred voice id (skills/elevenlabs, video pipelines):
ELEVENLABS_VOICE_ID_RU=

# Deepgram transcription (skills/deepgram). https://console.deepgram.com/
DEEPGRAM_API_KEY=

# HeyGen avatar video (skills/heygen). https://app.heygen.com/settings/api
HEYGEN_API_KEY=
# HeyGen web-session mode (heygen_web_client.py) — token/space from the
# logged-in web app (see skills/heygen SKILL.md):
HEYGEN_WEB_TOKEN=
HEYGEN_WEB_SPACE_ID=

# Higgsfield video generation (skills/video-generation) — browser session token:
HIGGSFIELD_ACCESS_TOKEN=

# Runway (skills/video-generation, b-roll) — from your logged-in session:
RUNWAY_TEAM_ID=
RUNWAY_USER_EMAIL=

# Suno music generation (video-editor talking-head music) — browser session:
SUNO_BEARER=
SUNO_SESSION_ID=
SUNO_DEVICE_ID=
SUNO_CLIENT_COOKIE=

# Freesound SFX library (video-editor sfx). https://freesound.org/apiv2/apply/
FREESOUND_API_KEY=

# Submagic captions (skills/submagic). https://www.submagic.co/
SUBMAGIC_API_KEY=

# Gamma slide decks (skills/gamma). https://gamma.app/
GAMMA_API_KEY=

# Manus slides (skills/manus, manus-slides):
MANUS_API_KEY=


# ----------------------------------------------------------------------------
# Google Cloud / Workspace
# ----------------------------------------------------------------------------
# OAuth token files for Gmail/Drive/Calendar live NEXT TO this file
# (google_oauth_token*.json) — see skills/google-workspace SKILL.md.
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=


# ----------------------------------------------------------------------------
# Messaging: Telegram / WhatsApp / SMS / VK
# ----------------------------------------------------------------------------
# Telegram MTProto app credentials (Telethon skills). https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Path or name of the Telethon session (optional, defaults are per-skill):
TELEGRAM_SESSION=

# Twilio SMS (skills/sms-twilio). https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# VK API (posting/creatives). https://dev.vk.com/
VK_ACCESS_TOKEN=


# ----------------------------------------------------------------------------
# Email (tools/email_client.py, tools/kb.py)
# ----------------------------------------------------------------------------
# Generic IMAP/SMTP account. email_client.py also supports per-account sets
# named MAIL_<NAME>_IMAP_HOST / MAIL_<NAME>_SMTP_HOST / MAIL_<NAME>_PASSWORD.
IMAP_HOST=
SMTP_HOST=
# Exchange Web Services password (tools/kb.py Outlook ingest):
EXCHANGE_PASSWORD=


# ----------------------------------------------------------------------------
# Business / SaaS integrations
# ----------------------------------------------------------------------------
# DaData company/contact enrichment, RU (skills/lead-enrichment). https://dadata.ru/api/
DADATA_API_KEY=
# Your CRM inbound webhook URL (lead pipelines):
CRM_WEBHOOK_URL=
# Figma (tools/figma_api.py). https://www.figma.com/developers/api#access-tokens
FIGMA_ACCESS_TOKEN=
# Miro REST (tools/miro_client.py). https://developers.miro.com/
MIRO_ACCESS_TOKEN=
MIRO_ORG_ID=
# Zoom Server-to-Server OAuth (skills/zoom). https://marketplace.zoom.us/
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Yandex OAuth (skills/yandex: Metrika, Direct, Disk...). https://oauth.yandex.ru/
YANDEX_OAUTH_TOKEN=
# DeepL translation (skills/deepl-pro). https://www.deepl.com/pro-api
DEEPL_API_KEY=
# Pinecone vector DB (skills/pinecone). https://app.pinecone.io/
PINECONE_API_KEY=
# Moonshot Kimi (skills/kimi). https://platform.moonshot.ai/
KIMI_API_KEY=


# ----------------------------------------------------------------------------
# AI-text detectors (skills/de-ai-ify verification loop)
# ----------------------------------------------------------------------------
GPTZERO_API_KEY=
ZEROGPT_API_KEY=
ORIGINALITY_API_KEY=
SAPLING_API_KEY=
COPYLEAKS_API_KEY=
COPYLEAKS_EMAIL=


# ----------------------------------------------------------------------------
# Local services / self-hosted
# ----------------------------------------------------------------------------
# Home Assistant (tools/ha_client.py): URL + long-lived access token
# (HA profile -> Security -> Long-lived access tokens).
HA_URL=
HA_TOKEN=
# Local agent-api-server (tools/agent_api_server.py) — invent your own secret:
AGENT_API_TOKEN=
# skills/n8n catalog API — invent your own secrets:
JWT_SECRET_KEY=
ADMIN_TOKEN=
ADMIN_PASSWORD=
# Claude Design web session (skills/claude-design) — from logged-in claude.ai:
CLAUDE_DESIGN_COOKIES=
CLAUDE_DESIGN_ORG_UUID=
# skills/last30days hosted mode (only if you run its server):
LAST30DAYS_API_KEY=
