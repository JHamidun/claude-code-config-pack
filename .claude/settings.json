{
  "cleanupPeriodDays": 99999,
  "env": {
    "PYTHONUTF8": "1",
    "PYTHONIOENCODING": "utf-8",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "MCP_TIMEOUT": "30000",
    "MCP_TOOL_TIMEOUT": "180000",
    "ENABLE_TOOL_SEARCH": "auto",
    "SUPERPOWERS_DISABLE_TELEMETRY": "1",
    "CLAUDE_CODE_THRIFTY_SONIC": "false",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "50",
    "CLAUDE_CODE_EAGER_FLUSH": "1",
    "CLAUDE_CODE_FORCE_SESSION_PERSISTENCE": "1",
    "CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS": "900000",
    "CLAUDE_CODE_GLOB_TIMEOUT_SECONDS": "60",
    "CLAUDE_CODE_RETRY_WATCHDOG": "1",
    "CLAUDE_CODE_MAX_RETRIES": "15",
    "CLAUDE_CODE_HARBOR_KITE": "1",
    "CLAUDE_CODE_ENABLE_SDK_FILE_CHECKPOINTING": "1",
    "CLAUDE_CODE_MAX_WEB_SEARCHES_PER_SESSION": "1000",
    "CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY": "16",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "5",
    "CLAUDE_CODE_BG_TASKS_REPORT_RUNNING": "1",
    "CLAUDE_CODE_ENABLE_REFRESH_MCP_TOOLS": "1",
    "CLAUDE_CODE_ENABLE_BACKGROUND_PLUGIN_REFRESH": "1",
    "CLAUDE_CODE_GZIP_REQUEST_BODIES": "1",
    "CLAUDE_CODE_ENABLE_FINE_GRAINED_TOOL_STREAMING": "1",
    "CLAUDE_CODE_WEB_FETCH_AGENT": "1",
    "CLAUDE_CODE_WORKFLOW_SIZE_WARNING_AGENTS": "60",
    "CLAUDE_CODE_ENABLE_EXPERIMENTAL_ADVISOR_TOOL": "1",
    "CLAUDE_CODE_PLAN_V2_AGENT_COUNT": "10",
    "CLAUDE_CODE_PLAN_V2_EXPLORE_AGENT_COUNT": "10",
    "CLAUDE_CODE_WORKFLOW_SIZE_WARNING_TOKENS": "20000000",
    "CLAUDE_CODE_DISABLE_EXPLORE_INHERIT_CAP": "1"
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "PowerShell(*)",
      "Write(*)",
      "Edit(*)",
      "MultiEdit(*)",
      "Bash(rm *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Write(.claude/**)",
      "Write(~/.claude/**)",
      "Edit(.claude/**)",
      "Edit(~/.claude/**)",
      "Edit(/.claude/**)",
      "Write(/.claude/**)",
      "Read(/.claude/**)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(py *)",
      "Bash(powershell *)",
      "Bash(pwsh *)",
      "Bash(powershell.exe *)",
      "Bash(node *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(bun *)",
      "Bash(bunx *)",
      "Bash(uv *)",
      "Bash(uvx *)",
      "Bash(pip *)",
      "Bash(pipx *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(docker *)",
      "Bash(docker-compose *)",
      "Bash(kubectl *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(make *)",
      "Bash(cmake *)",
      "Bash(cargo *)",
      "Bash(go *)",
      "Bash(rustc *)",
      "Bash(deno *)",
      "Bash(jq *)",
      "Bash(yq *)",
      "Bash(ffmpeg *)",
      "Bash(yt-dlp *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(echo *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(tar *)",
      "Bash(zip *)",
      "Bash(unzip *)",
      "PowerShell",
      "Read",
      "Read(*)",
      "Read(~/**)",
      "Write",
      "Write(~/.claude.json)",
      "Write(~/**)",
      "Edit",
      "Edit(~/.claude.json)",
      "Edit(~/**)",
      "MultiEdit",
      "NotebookEdit",
      "NotebookEdit(*)",
      "Glob",
      "Grep",
      "Workflow",
      "Task",
      "Agent",
      "WebFetch",
      "WebSearch",
      "TodoWrite",
      "SlashCommand",
      "Skill",
      "ToolSearch",
      "ScheduleWakeup",
      "mcp__filesystem__*",
      "mcp__notebooklm__*",
      "mcp__google-studio__*",
      "mcp__runway__*",
      "mcp__graph-memory__*",
      "mcp__postiz__*",
      "mcp__chrome-devtools__*",
      "mcp__plugin_Notion_notion__*",
      "mcp__plugin_figma_figma__*",
      "mcp__plugin_linear_linear__*",
      "mcp__plugin_playwright_playwright__*",
      "mcp__plugin_sentry_sentry__*",
      "mcp__plugin_slack_slack__*",
      "mcp__plugin_telegram_telegram__*",
      "mcp__context7__*",
      "mcp__firecrawl__*",
      "mcp__exa__*",
      "Bash(cat >> *)",
      "mcp__playwright-live1__*",
      "mcp__playwright-live2__*",
      "mcp__playwright-live3__*",
      "mcp__playwright-live4__*",
      "mcp__playwright-live5__*",
      "mcp__playwright-live6__*",
      "mcp__playwright-live7__*",
      "mcp__playwright-live8__*",
      "mcp__playwright-live9__*",
      "mcp__playwright-live10__*",
      "Bash(cat > *)",
      "Bash(cat)",
      "Bash(PYTHONUTF8=1 python -)",
      "mcp__claude_ai_Google_Calendar__list_events",
      "Bash(python -c ' *)",
      "Bash(curl -s *)",
      "mcp__codex__codex",
      "mcp__codex__codex-reply"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf $HOME)",
      "Bash(rm -rf $HOME/*)",
      "Bash(rm -rf C:/)",
      "Bash(rm -rf C:/Users)",
      "Bash(rm -rf C:/Windows)",
      "Bash(*DROP DATABASE*)",
      "Bash(*DROP TABLE*)",
      "Bash(*DROP SCHEMA*)",
      "Bash(*TRUNCATE TABLE*)",
      "Bash(git push --force origin main*)",
      "Bash(git push --force origin master*)",
      "Bash(git push -f origin main*)",
      "Bash(git push -f origin master*)",
      "Bash(git reset --hard HEAD~*)",
      "Bash(*shutdown*)",
      "Bash(*format C:*)",
      "Bash(dd if=*of=/dev/sd*)",
      "PowerShell(*Remove-Item -Recurse -Force C:\\*)",
      "PowerShell(*Format-Volume*)",
      "PowerShell(*Stop-Computer*)",
      "PowerShell(*Restart-Computer*)"
    ],
    "ask": [],
    "defaultMode": "bypassPermissions",
    "additionalDirectories": []
  },
  "fallbackModel": [
    "claude-opus-5"
  ],
  "enableAllProjectMcpServers": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${HOME}/.claude/hooks/guard.js\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${HOME}/.claude/hooks/gsd-check-update.js\"",
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"${HOME}/.claude/hooks/gsd-statusline.js\""
  },
  "enabledPlugins": {
    "agent-sdk-dev@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "coderabbit@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "dev-browser@dev-browser-marketplace": true,
    "feature-dev@claude-plugins-official": true,
    "firecrawl@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "greptile@claude-plugins-official": true,
    "linear@claude-plugins-official": false,
    "notion@claude-plugins-official": false,
    "playground@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "sourcegraph@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "telegram@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true,
    "claude-security@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "receipts@claude-plugins-official": true,
    "project-artifact@claude-plugins-official": true,
    "pdf-viewer@knowledge-work-plugins": false,
    "mcp-server-dev@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "knowledge-work-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/knowledge-work-plugins"
      }
    },
    "dev-browser-marketplace": {
      "source": {
        "source": "git",
        "repo": "sawyerhood/dev-browser",
        "url": "https://github.com/sawyerhood/dev-browser.git"
      }
    }
  },
  "language": "ru",
  "effortLevel": "xhigh",
  "autoUpdatesChannel": "latest",
  "skipDangerousModePermissionPrompt": true,
  "preferredNotifChannel": "terminal_bell",
  "mcpServers": {
    "graph-memory": {
      "command": "python",
      "args": [
        "${HOME}/.claude/mcps/graph-memory/server.py"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      },
      "disabled": false,
      "description": "Граф твоей памяти: соседи, пути, хабы, разрывы. Строится из ~/.claude/projects/*/memory/*.md, база создаётся пустой."
    },
    "filesystem": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ],
      "command": "npx"
    },
    "runway": {
      "type": "stdio",
      "command": "python",
      "args": [
        "-u",
        "${HOME}/.claude/skills/video-generation/scripts/runway_mcp.py"
      ],
      "disabled": true
    },
    "playwright-live1": {
      "command": "npx",
      "args": [
        "@playwright/mcp@0.0.78",
        "--user-data-dir",
        "${HOME}/.claude/pw-profiles/live1"
      ]
    },
    "pageindex": {
      "command": "npx",
      "args": [
        "-y",
        "@pageindex/mcp"
      ],
      "disabled": true
    },
    "miro": {
      "type": "http",
      "url": "https://mcp.miro.com/",
      "disabled": true
    }
  },
  "skillListingBudgetFraction": 0.08,
  "skillListingMaxDescChars": 400,
  "autoContinueAtUsageLimit": true,
  "awaySummaryEnabled": true,
  "taskCompleteNotifEnabled": true,
  "fileCheckpointingEnabled": true,
  "autoCompactWindow": 1000000,
  "workflowSizeGuideline": "large",
  "inputNeededNotifEnabled": true,
  "skipWorkflowUsageWarning": true,
  "dialogExpiry": "10m",
  "crossSessionInbound": "accept"
}