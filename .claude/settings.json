{
  "cleanupPeriodDays": 90,
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(pip install *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(node *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Task",
      "WebFetch",
      "WebSearch",
      "TodoWrite",
      "SlashCommand",
      "Skill",
      "mcp__*"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf $HOME)",
      "Bash(rm -rf $HOME/*)",
      "Bash(rm -rf C:/)",
      "Bash(rm -rf C:/Users)",
      "Bash(rm -rf C:/Windows)",
      "Bash(:(){ :|:& };:)",
      "Bash(*DROP DATABASE*)",
      "Bash(*DROP TABLE*)",
      "Bash(*DROP SCHEMA*)",
      "Bash(*TRUNCATE TABLE*)",
      "Bash(git push --force origin main*)",
      "Bash(git push --force origin master*)",
      "Bash(git push -f origin main*)",
      "Bash(git push -f origin master*)",
      "Bash(git reset --hard HEAD~*)",
      "Bash(*shutdown*)",
      "Bash(*format C:*)",
      "Bash(dd if=*of=/dev/sd*)",
      "PowerShell(*Remove-Item -Recurse -Force C:\\*)",
      "PowerShell(*Format-Volume*)",
      "PowerShell(*Stop-Computer*)",
      "PowerShell(*Restart-Computer*)"
    ],
    "ask": [],
    "defaultMode": "default",
    "additionalDirectories": [
      "${HOME}\\.claude",
      "${HOME}\\.claude.json",
      "${WORKSPACE}"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:VSCODE_PORT/hook",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:VSCODE_PORT/hook",
            "timeout": 120
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:VSCODE_PORT/hook",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:VSCODE_PORT/hook",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:VSCODE_PORT/hook",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:VSCODE_PORT/hook",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash(rm -rf)",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'BLOCKED: Dangerous rm -rf command' && exit 1"
          }
        ]
      },
      {
        "matcher": "Bash(DROP DATABASE)",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'BLOCKED: DROP DATABASE command' && exit 1"
          }
        ]
      },
      {
        "matcher": "Bash(DROP TABLE)",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'BLOCKED: DROP TABLE command' && exit 1"
          }
        ]
      },
      {
        "matcher": "Bash(git commit)",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -c \"Write-Output 'COMMIT_FORMAT: Use Conventional Commits (feat/fix/chore/docs/refactor/test/ci). Example: feat(auth): add OAuth2 login'\"",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${HOME}/.claude/hooks/security-guard.js\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:VSCODE_PORT/hook",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:VSCODE_PORT/hook",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${HOME}/.claude/hooks/gsd-check-update.js\""
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:VSCODE_PORT/hook",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -c \"[console]::beep(800,200); [console]::beep(1000,200)\"",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:VSCODE_PORT/hook",
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:VSCODE_PORT/hook",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:VSCODE_PORT/hook",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:VSCODE_PORT/hook",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:VSCODE_PORT/hook",
            "timeout": 5
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:VSCODE_PORT/hook",
            "timeout": 5
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:VSCODE_PORT/hook",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"${HOME}/.claude/hooks/gsd-statusline.js\""
  },
  "enabledPlugins": {
    "adspirer-ads-agent@claude-plugins-official": true,
    "agent-sdk-dev@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "coderabbit@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "dev-browser@dev-browser-marketplace": true,
    "feature-dev@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "firecrawl@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "greptile@claude-plugins-official": true,
    "huggingface-skills@claude-plugins-official": true,
    "laravel-boost@claude-plugins-official": false,
    "legalzoom@claude-plugins-official": true,
    "linear@claude-plugins-official": true,
    "mintlify@claude-plugins-official": false,
    "notion@claude-plugins-official": true,
    "playground@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": false,
    "semgrep@claude-plugins-official": true,
    "sentry@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "sourcegraph@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "telegram@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "zapier@claude-plugins-official": false
  },
  "skipDangerousModePermissionPrompt": false,
  "preferredNotifChannel": "terminal_bell",
  "mcpServers": {
    "graph-memory": {
      "command": "python",
      "args": [
        "${HOME}\\.claude\\graph-memory\\mcp_server.py"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8"
      },
      "disabled": true
    },
    "notebooklm": {
      "command": "python",
      "args": [
        "${HOME}\\.claude\\mcps\\notebooklm-mcp\\src\\server.py"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8"
      },
      "disabled": true
    },
    "google-studio": {
      "command": "python",
      "args": [
        "${HOME}\\.claude\\mcps\\google-studio-mcp\\src\\server.py"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8"
      },
      "disabled": true
    },
    "filesystem": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${WORKSPACE}",
        "${HOME}"
      ],
      "command": "npx"
    },
    "postiz": {
      "command": "node",
      "args": [
        "${HOME}\\postiz-mcp-repo\\build\\index.js"
      ],
      "env": {
        "POSTIZ_API_KEY": "${POSTIZ_API_KEY}",
        "POSTIZ_BASE_URL": "http://YOUR_SERVER_IP:4007/public/v1"
      },
      "disabled": true
    },
    "runway": {
      "type": "stdio",
      "command": "python",
      "args": [
        "-u",
        "${HOME}/.claude/skills/runway-api/scripts/runway_mcp.py"
      ],
      "disabled": true
    }
  }
}