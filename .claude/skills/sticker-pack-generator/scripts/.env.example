# Telegram (Telethon) — get from https://my.telegram.org
TELEGRAM_API_ID=<your_api_id>
TELEGRAM_API_HASH=<your_api_hash>
TELEGRAM_SESSION=~/.telegram_session

# OpenAI — for gpt-image-2 mascot / emotion generation
OPENAI_API_KEY=<your_openai_key>
OPENAI_IMAGE_MODEL=gpt-image-1

# SAM2 (optional — animated pipeline only)
SAM2_CHECKPOINT=./sam2_checkpoints/sam2.1_hiera_small.pt
SAM2_CONFIG=configs/sam2.1/sam2.1_hiera_s.yaml

# WSL alpha_encoder (optional — animated pipeline only)
WSL_DISTRO=Ubuntu-22.04
ALPHA_ENCODER_PATH=/opt/webm-tools/alpha_encoder/alpha_encoder
