{
  "name": "remotion-overlays",
  "version": "1.0.0",
  "private": true,
  "description": "Transparent social-UI overlays (Instagram/Telegram chrome) for compositing over b-roll via ffmpeg. Render to alpha webm, then overlay.",
  "scripts": {
    "preview": "remotion studio",
    "render:ig": "remotion render InstagramStory out/ig.webm --codec=vp9 --pixel-format=yuva420p --image-format=png",
    "render:tg": "remotion render TelegramForward out/tg.webm --codec=vp9 --pixel-format=yuva420p --image-format=png"
  },
  "dependencies": {
    "@remotion/cli": "4.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.0"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "typescript": "5.5.4"
  }
}
