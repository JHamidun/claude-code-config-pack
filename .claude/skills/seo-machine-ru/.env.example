# Скопируйте в .env и заполните СВОИМИ значениями. .env в .gitignore — не коммитьте.

# Аккаунт Яндекса для Wordstat (вход в браузере; 2FA проходит владелец).
YANDEX_LOGIN=your_login@yandex.ru
YANDEX_PASSWORD=your_password

# OAuth-токен Яндекса для Вебмастер/Метрика API (необязательно).
# Получить: https://oauth.yandex.ru/  (scope: webmaster + metrika)
YANDEX_OAUTH_TOKEN=

# Регион Wordstat по умолчанию: 225=Россия, 213=Москва, 2=СПб
WORDSTAT_REGION=225
